+/*
+ * Bulk streaming. Isochronous IN on dwc2 without descriptor DMA (e.g. the
+ * Raspberry Pi 4) has to re-arm the endpoint from the completion interrupt
+ * before every service interval and loses a large share of packets; bulk has
+ * no such deadline. Every request carries one payload of bulk_payload bytes,
+ * which userspace must report as dwMaxPayloadTransferSize.
+ */
+static bool uvc_bulk;
+module_param_named(bulk, uvc_bulk, bool, 0444);
+MODULE_PARM_DESC(bulk, "Stream over a bulk endpoint instead of isochronous");
 
+static unsigned int uvc_bulk_payload = 16384;
+module_param_named(bulk_payload, uvc_bulk_payload, uint, 0444);
+MODULE_PARM_DESC(bulk_payload, "Bulk payload (and request) size in bytes");
