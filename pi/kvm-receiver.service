[Unit]
Description=briKVM receiver (Mac UDP -> v4l2loopback MJPEG + ALSA UAC2Gadget)
After=kvm-gadget.service network-online.target
Requires=kvm-gadget.service
Wants=network-online.target
Before=kvm-uvc.service
ConditionPathExists=/dev/video50

[Service]
Type=simple
EnvironmentFile=-/etc/kvm-receiver.env
ExecStart=/usr/bin/python3 /opt/kvm/receiver.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
