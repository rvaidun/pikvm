[Unit]
Description=briKVM HDMI capture (TC358743 CSI -> ustreamer :8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/kvm-ustreamer.env
ExecStart=/opt/kvm/hdmi-capture.sh
Restart=always
RestartSec=2
# Core 3 is reserved for the USB controller interrupt (see setup-gadget.sh).
CPUAffinity=0-2
DynamicUser=yes
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
